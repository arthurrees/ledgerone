# Copy this file to .env and fill in your own values. .env is gitignored.

# Plaid API credentials — https://dashboard.plaid.com/
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=production
# PLAID_REDIRECT_URI is only needed for OAuth institutions (not Chase).

# Optional: Telegram bot token if you wire up notifications.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Francis LLM gateway. Keep the bearer token only in backend/.env.
LEDGERONE_LLM_BASE_URL=http://100.83.194.119:5560/v1
LEDGERONE_LLM_API_KEY=your_francis_gateway_key
LEDGERONE_LLM_MODEL=qwen3.5-gpu:latest

# Production listener on Son of Francis.
LEDGERONE_HOST=100.96.116.18
LEDGERONE_PORT=8787
