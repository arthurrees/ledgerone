[Unit]
Description=LedgerOne financial backend
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/arthur/Projects/LedgerOne/backend
EnvironmentFile=/home/arthur/Projects/LedgerOne/backend/.env
ExecStart=/home/arthur/Projects/LedgerOne/backend/.venv/bin/python server.py
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
